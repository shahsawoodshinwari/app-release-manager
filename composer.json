{
    "name": "shaka/app-release-manager",
    "description": "Laravel package to manage application releases across platforms and distribution channels, and enforce per-application release/update policies.",
    "keywords": [
        "Shaka",
        "laravel",
        "app-release-manager",
        "release-management",
        "distribution"
    ],
    "homepage": "https://github.com/shahsawoodshinwari/app-release-manager",
    "license": "MIT",
    "authors": [
        {
            "name": "Shah Sawood",
            "email": "shahsawoodshinwari@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^10.0"
    },
    "require-dev": {
        "laravel/framework": "^10.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.0",
        "larastan/larastan": "^2.0",
        "orchestra/testbench": "^8.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Shaka\\AppReleaseManager\\": "src/",
            "Shaka\\AppReleaseManager\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shaka\\AppReleaseManager\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shaka\\AppReleaseManager\\AppReleaseManagerServiceProvider"
            ],
            "aliases": {
                "AppReleaseManager": "Shaka\\AppReleaseManager\\Facades\\AppReleaseManager"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
